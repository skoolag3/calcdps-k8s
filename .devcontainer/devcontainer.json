{
  "name": "Python 3 - K8s Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "deployment.yaml",
        "service.yaml"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "updateContentCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo '✅ Requirements met'",
  "portsAttributes": {
    "8501": {
      "label": "CalcDPS Service",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "Forwarded App",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501,
    8080
  ]
}
